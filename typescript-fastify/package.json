{
  "name": "typescript-fastify",
  "version": "1.0.0",
  "private": true,
  "description": "The Cero API on Fastify 5.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "db:up": "docker compose -f ../docker-compose.yml up -d mongo"
  },
  "dependencies": {
    "@cero/core": "workspace:*",
    "@cero/mongoose": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "fastify": "^5.12.5",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~6.0.3"
  }
}

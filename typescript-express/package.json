{
  "name": "typescript-express",
  "version": "1.0.0",
  "private": true,
  "description": "The Cero API on Express 5.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "db:up": "docker compose -f ../docker-compose.yml up -d mongo"
  },
  "dependencies": {
    "@cero/core": "workspace:*",
    "@cero/mongoose": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "typescript": "~6.0.3"
  }
}

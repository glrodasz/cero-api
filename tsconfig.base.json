{
  // Shared by every TypeScript workspace.
  //
  // The code runs straight from source: Node strips the types at runtime
  // (no build step), and so do Deno, esbuild and SWC. That is why imports
  // use `.ts` extensions and only erasable syntax is allowed.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  }
}

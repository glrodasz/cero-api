APP_NAME=cero-api
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# The same variable every stack in this repository reads. Without it, the
# DB_* variables (or their defaults: root:root@127.0.0.1:5432/cero_laravel) apply.
DATABASE_URL=postgres://root:root@127.0.0.1:5432/cero_laravel

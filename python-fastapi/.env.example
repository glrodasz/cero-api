# postgres (default), mongodb, or memory (no database needed; data is lost on restart)
STORAGE=postgres
DATABASE_URL=postgresql+asyncpg://root:root@127.0.0.1:5432/cero_python
MONGODB_URI=mongodb://root:root@127.0.0.1:27017/cero_python?authSource=admin
# PORT (default 8000) is read by `fastapi run` from the environment, not from this file.

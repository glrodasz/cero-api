{
  "name": "typescript-graphql",
  "version": "1.0.0",
  "private": true,
  "description": "The Cero API as GraphQL, on GraphQL Yoga 5.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "db:up": "docker compose -f ../docker-compose.yml up -d mongo"
  },
  "dependencies": {
    "@cero/core": "workspace:*",
    "@cero/graphql-schema": "workspace:*",
    "@cero/mongoose": "workspace:*",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~6.0.3"
  }
}
